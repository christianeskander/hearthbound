  },
  "dependencies": {
    "phaser": "^3.90.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
